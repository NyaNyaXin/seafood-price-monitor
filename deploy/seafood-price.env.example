# 采集端与服务端共用的数据库连接配置
# 用法：
#   Linux  -> sudo cp deploy/seafood-price.env.example /etc/seafood-price.env && sudo chmod 600 /etc/seafood-price.env
#   Windows-> 复制成项目根目录 .env，或直接设为系统环境变量（采集脚本和 Node 都认 DB_*）
#
# 同一份变量同时被 scripts/config.py（采集）与 server/utils/pg.ts（看板）读取。

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=seafood
DB_PASSWORD=change-me
DB_NAME=seafood_price
DB_CONNECT_TIMEOUT=8
