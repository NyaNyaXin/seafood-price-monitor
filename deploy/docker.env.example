# Docker 部署环境变量模板
#
#   cp deploy/docker.env.example .env
#   vi .env            # 填真实数据库连接
#   docker compose up -d --build
#
# 说明：.env 放在项目根目录（与 docker-compose.yml 同级），compose 会自动读取并做变量替换。
# 密码含 # 空格 $ 等特殊字符时用单引号包起来，例如 DB_PASSWORD='p@ss#2026$'
# .env 已在 .gitignore 与 .dockerignore 里，不会被提交、也不会进镜像。

# ---------- 数据库（PostgreSQL 已在单独容器里运行，这里只填怎么连）----------
# 方案 A：PG 容器把端口发布到了宿主机（docker ps 里能看到 0.0.0.0:5432->5432/tcp）
DB_HOST=host.docker.internal
# 方案 B：把 PG 容器接到 seafood-net 网络（docker network connect seafood-net <PG容器名>）
#        然后改成容器名，容器间直连，不必发布端口
# DB_HOST=seafood-postgres
# 方案 C：外部数据库（云数据库 / 另一台机器）
# DB_HOST=10.0.0.12

DB_PORT=5432
DB_USER=seafood
DB_PASSWORD=change-me
DB_NAME=seafood_price
DB_CONNECT_TIMEOUT=8

# ---------- Web ----------
# 宿主机监听地址：只给 Nginx/Caddy 反代就填 127.0.0.1，直接对外就留 0.0.0.0
WEB_BIND=0.0.0.0
WEB_PORT=3000
APP_VERSION=latest

# ---------- 看板「立即采集」按钮（仅本机）----------
# web 容器不含 Python 与 scripts/，线上按钮会自动禁用；本机 .env 配置后可在看板点按钮触发采集
# FETCH_TOKEN=change-me

# ---------- 采集 ----------
# 每天几点跑（容器内 Asia/Shanghai），可逗号分隔多个时间点；首次启动是否立刻跑一次
FETCH_AT=12:00,17:00
RUN_ON_START=true

# 时区：影响采集的 obs_date 与日志时间，别改成 UTC
TZ=Asia/Shanghai

# ---------- 网络 ----------
# 自定义网络名。若 PG 容器已在某个网络里，填那个网络名即可复用
DOCKER_NETWORK=seafood-net
