# 同机服务器部署配置模板（部署目录 /opt/seafood-price-monitor）
#
#   cp deploy/server.env.example .env
#   vi .env      # 至少填 DB_PASSWORD 与 PG_ADMIN_PASSWORD
#   bash scripts/deploy.sh
#
# 复用服务器上已有的 PostgreSQL 容器 ledger-db 与共享网络 ledger-shared-net，
# 只新建本应用专用库与账号，不启动、重建或改动其他项目。

# ---------- Web 对外 ----------
# 新开的外网端口，避开同机已用的 38080/38081/38082
WEB_BIND=0.0.0.0
WEB_PORT=38083

# ---------- 数据库（走共享网络，主机名即容器名）----------
DB_HOST=ledger-db
DB_PORT=5432
DB_USER=seafood
DB_NAME=seafood_price
DB_PASSWORD=
DB_CONNECT_TIMEOUT=8

# 仅 scripts/deploy.sh 建库建账号时使用：ledger-db 的 postgres 管理员密码
PG_ADMIN_PASSWORD=

# ---------- 采集 ----------
# 每天采集时刻，可逗号分隔多个时间点（容器本地时间 Asia/Shanghai）
FETCH_AT=12:00,17:00
RUN_ON_START=true

# 时区：影响 obs_date 与日志时间，别改成 UTC
TZ=Asia/Shanghai
